# Neo4j
NEO4J_URI=neo4j+s://example.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Embeddings
ENABLE_EMBEDDING_ROUTER=false
EMBEDDING_MODEL=jina-embeddings-v5-text-small-retrieval-GGUF
EMBEDDING_VECTOR_DIMENSIONS=1024
EMBEDDING_NORMALIZED=true
EMBEDDING_VARIANT=Q8
EMBEDDING_PROFILE_ID=jina_v5_q8_1024_norm_v1
EMBEDDING_PROVIDER=jina_local
EMBEDDING_QUERY_TASK=retrieval.query
EMBEDDING_DOCUMENT_TASK=retrieval.passage
LLAMA_SERVER_URL=http://127.0.0.1:18080/v1/embeddings
JINA_API_BASE_URL=https://api.jina.ai/v1/embeddings
JINA_API_KEY=

# Runtime contours
LEGAL_RUNTIME_CONTOUR=operator_managed
LEGAL_EXTRACTION_POLICY_VERSION=legal_extraction_v1
LEGAL_OPERATOR_LLM_BACKEND=operator_remote
LEGAL_OPERATOR_EMBEDDING_BACKEND=llama_server_local
LEGAL_MANAGED_LLM_BACKEND=paid_api
LEGAL_MANAGED_EMBEDDING_BACKEND=jina_api
LEGAL_MANAGED_SMOKE_LIMIT=5

# Tests
RUN_LIVE_NEO4J_TESTS=false
RUN_LIVE_EMBEDDING_TESTS=false
