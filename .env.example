# Neo4j live graph operations
NEO4J_URI=neo4j+s://example.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Leave empty to use the server default database.
NEO4J_DATABASE=

# Corpus preview
CORPUS_MANIFEST_PATH=tests/fixtures/legal_xml_import_manifest.json
PREVIEW_OUTPUT_PATH=data/import_preview/legal_xml_preview.json

# Embedding profile and local-only endpoint
EMBEDDING_PROFILE_ID=jina_v5_q8_1024_norm_v1
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL_ID=jina-embeddings-v5-text-small-retrieval-GGUF
EMBEDDING_VECTOR_DIMENSIONS=1024
EMBEDDING_NORMALIZED=true
EMBEDDING_VARIANT=Q8
EMBEDDING_QUERY_PREFIX="Query: "
EMBEDDING_DOCUMENT_PREFIX="Document: "
EMBEDDING_ROUTING_MODE=local_only
EMBEDDING_ENDPOINT_URL=http://127.0.0.1:18080/v1/embeddings

# Test gates. Default unit tests must not require live services.
RUN_LIVE_NEO4J_TESTS=false
RUN_LIVE_EMBEDDING_TESTS=false
